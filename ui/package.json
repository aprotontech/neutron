{
  "name": "neutron-fileviewer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5173",
    "cap:copy": "npx cap copy --web-dir=www",
    "cap:sync": "npx cap sync --web-dir=www",
    "ship": "vite build && npx cap sync --web-dir=www",
    "proto:generate": "cd ../protocol && ../ui/node_modules/.bin/pbjs -t static-module -w es6 --es6 -o ../ui/src/lib/proto/neutron_pb.js *.proto",
    "proto": "npm run proto:generate"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@capacitor-community/sqlite": "^8.0.0",
    "@capacitor/android": "^8.0.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@capacitor/filesystem": "^8.1.0",
    "@capacitor/ios": "^8.0.2",
    "@capacitor/status-bar": "^8.0.0",
    "dotenv": "^17.2.3",
    "element-plus": "^2.3.0",
    "google-protobuf": "^4.0.1",
    "heic2any": "^0.0.4",
    "highlight.js": "^11.11.1",
    "md5": "^2.3.0",
    "platform": "^1.3.6",
    "spark-md5": "^3.0.2",
    "uuid": "^13.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@types/node": "^25.1.0",
    "@vitejs/plugin-vue": "^4.1.0",
    "protobufjs-cli": "^2.0.0",
    "typescript": "^5.9.3",
    "vite": "^5.0.0"
  }
}
