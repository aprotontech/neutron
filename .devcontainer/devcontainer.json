{
    "name": "neutron",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "postCreateCommand": "echo xyz",
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.go",
                "ms-vscode.makefile-tools",
                "aleksandra.go-group-imports",
                "Vue.volar"
            ]
        }
    },
    "mounts": [
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/aproton/.ssh,type=bind,consistency=cached",
        "source=${localWorkspaceFolder}/ui/.cache/android,target=/home/aproton/.android,type=bind,consistency=cached",
        "source=${localWorkspaceFolder}/ui/.cache/gradle,target=/home/aproton/.gradle,type=bind,consistency=cached"
    ],
    "privileged": true,
    "capAdd": ["SYS_ADMIN"],
    "runArgs": [ "--security-opt", "apparmor:unconfined", "--network=host" ]
}
